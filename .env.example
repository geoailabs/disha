# ==============================================================================
# DISHA ENVIRONMENT CONFIGURATION
# Copy this file to '.env' in this directory (or in packages/backend/.env)
# ==============================================================================

# OpenAI API Key (Required for AI Chat, spatial analysis tools, and RAG index)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API Key (Optional: for Google Geocoding, Places, and Street View)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Earth Engine Credentials (Optional: raw service account JSON string or path to JSON keyfile)
GEE_CREDENTIALS=your_gee_service_account_json_or_file_path

# Log Level (Optional: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
